# Copy to .env in this backend/ folder. NEVER commit .env.

# MST Testnet RPC (official, from mst-sdk-python docs)
RPC_URL=https://testnetrpc.mstblockchain.com

# Deployed SecurityPolicyRegistry address (from Phase 1/2)
CONTRACT_ADDRESS=

# Private key of the account that PROPOSES policies via this API.
# Testnet-only key. Never mainnet funds.
PROPOSER_PRIVATE_KEY=

# Private key of the account that APPROVES policies via this API.
# Must match the authorizedApprover address the contract was deployed with.
# For the demo this can be the SAME key/account as PROPOSER_PRIVATE_KEY.
APPROVER_PRIVATE_KEY=

# Port for the backend HTTP server
PORT=4000

# V2 versioned registry configuration
CONTRACT_V2_ADDRESS=
SECURITY_APPROVER_PRIVATE_KEY=
NETWORK_APPROVER_PRIVATE_KEY=
