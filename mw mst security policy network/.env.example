# Copy this file to .env and fill in real values. NEVER commit .env.

# A TESTNET-ONLY private key (0x-prefixed). Fund it via the MST faucet:
# https://faucet.mstblockchain.com
# Do not use a key that holds mainnet funds.
PRIVATE_KEY=

# The address allowed to call approvePolicy() on the deployed registry.
# Can be the same address as PRIVATE_KEY's account for this milestone,
# or a separate "approver" wallet if you want to demo the propose/approve
# split with two different signers.
APPROVER_ADDRESS=

# V2 requires two distinct testnet approver addresses.
SECURITY_APPROVER_ADDRESS=
NETWORK_APPROVER_ADDRESS=
